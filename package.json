{
  "name": "cfecc-stores-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "CFECC Stores Management System - Enterprise Retail, Inventory, POS, Credit & Payroll Recovery Platform",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @cfecc/server dev\" \"pnpm --filter @cfecc/client dev\"",
    "build": "pnpm --filter @cfecc/server build && pnpm --filter @cfecc/client build",
    "start": "pnpm --filter @cfecc/server start",
    "test": "pnpm --filter @cfecc/server test && pnpm --filter @cfecc/client test",
    "db:generate": "pnpm --filter @cfecc/server db:generate",
    "db:migrate": "pnpm --filter @cfecc/server db:migrate",
    "db:seed": "pnpm --filter @cfecc/server db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
